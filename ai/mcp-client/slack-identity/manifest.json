{
  "display_information": {
    "name": "MCP Profile Card",
    "description": "Looks up Slack user profiles via MCP (Slack identity auth)"
  },
  "features": {
    "bot_user": {
      "display_name": "MCP Profile Card",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://YOUR_URL.ngrok-free.app/slack/oauth_redirect"],
    "scopes": {
      "bot": ["mcp:connect", "users:read", "users:read.email"]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  },
  "mcp_servers": {
    "profile": {
      "url": "https://YOUR_URL.ngrok-free.app/mcp",
      "auth_type": "slack_identity_auth"
    }
  }
}
