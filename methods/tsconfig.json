{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "**/src/**/*.js",
    "**/tests/**/*.js"
  ]
}
