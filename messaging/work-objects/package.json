{
	"name": "work-objects-showcase",
	"version": "1.0.0",
	"description": "A sample app showcasing Work Objects",
	"main": "dist/app.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "npm run build && node ./dist/app.js",
		"lint": "npx @biomejs/biome check *.ts listeners tests",
		"lint:fix": "npx @biomejs/biome check --write *.ts listeners tests",
		"test": "npm run build && npm run lint && node --import tsx --test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/slack-samples/bolt-js-showcase.git"
	},
	"author": "Slack Technologies, LLC",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/slack-samples/bolt-js-showcase/issues"
	},
	"homepage": "https://github.com/slack-samples/bolt-js-showcase/blob/main/surfaces/app-home/README.md",
	"dependencies": {
		"@slack/bolt": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@slack/cli-hooks": "^1.2.1",
		"@types/node": "^24.10.0",
		"cross-env": "^10.1.0",
		"typescript": "^5.9.3"
	}
}
