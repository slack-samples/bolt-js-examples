{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "check": "npx tsc --checkJs --esModuleInterop --module nodenext --noEmit src/*.js tests/*.js",
    "lint": "npx @biomejs/biome check src tests",
    "lint:fix": "npx @biomejs/biome check --write src tests",
    "test": "cross-env NODE_ENV=test node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slack-samples/bolt-js-showcase.git"
  },
  "author": "Slack Technologies, LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/slack-samples/bolt-js-showcase/issues"
  },
  "homepage": "https://github.com/slack-samples/bolt-js-showcase/blob/main/surfaces/app-home/README.md",
  "dependencies": {
    "@slack/bolt": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@slack/cli-hooks": "^1.2.1",
    "@types/node": "^24.10.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
