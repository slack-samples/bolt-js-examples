{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npx tsc --checkJs --noEmit --types node src/**/*.js tests/**/*.js",
    "lint": "npx @biomejs/biome check src tests",
    "lint:fix": "npx @biomejs/biome check --write src tests",
    "test": "node --test"
  },
