    "url": "https://github.com/slack-samples/bolt-js-examples/issues"
  },
  "homepage": "https://github.com/slack-samples/bolt-js-examples/blob/main/block-kit/README.md",
  "dependencies": {
    "@slack/types": "^2.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
